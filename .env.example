# Liquid Wire — Environment Variables & Secrets
#
# Copy this file to .env (not committed) or set as GitHub Actions secrets/variables.
# Secrets (sensitive) should be set via `gh secret set`. Variables (non-sensitive)
# can be set via `gh variable set` or repository settings.

# ── Secrets (sensitive) ──────────────────────────────────────────────────────

# YouTube OAuth2 token JSON (from utils/youtube_oauth.py first-run flow).
# Required for uploads, analytics, comment engagement, and channel identity updates.
YOUTUBE_TOKEN=

# Google Gemini API key for AI-assisted titles, descriptions, captions, thumbnails.
# Optional but recommended — without it, fallback local generators are used.
GEMINI_API_KEY=

# Fine-grained GitHub PAT for automatic OAuth token refresh (oauth-token-refresh.yml).
# Optional — without it, token refresh is manual every ~90 days.
GH_PAT=

# Slack-compatible webhook URL for operational alerts (quota, SLA failures, etc.).
# Optional — without it, alerts are logged but not sent externally.
LIQUID_WIRE_ALERT_WEBHOOK=

# ── Variables (non-sensitive) ────────────────────────────────────────────────

# Master feature flag: set to "1" to enable the production pipeline.
LIQUID_WIRE_ENABLED=0

# Upload privacy status: "private" (recommended) or "public".
# Private uploads go through Content ID check before being published.
YOUTUBE_PRIVACY=private

# Enable comment engagement workflow (respond_comments.py).
LIQUID_WIRE_COMMENTS_ENABLED=0

# Enable channel identity rotation (update_channel_identity.py).
LIQUID_WIRE_IDENTITY_ENABLED=0

# BRT offset for mood/slot scheduling (default: -3 for UTC-3).
BRT_OFFSET_HOURS=-3

# Allow batch generation to publish multiple public videos in one run.
# Leave unset unless you explicitly want to bypass the single-public-release guard.
# ALLOW_MULTI_PUBLIC_BATCH=1

# Override the active channel (default: liquid_wire).
# YOUTUBE_CHANNEL=liquid_wire